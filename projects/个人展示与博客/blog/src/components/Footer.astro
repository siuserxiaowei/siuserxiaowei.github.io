    <div class="footer-bottom">
      <p>&copy; {year} siuser小伟</p>
      <p class="footer-note">All drafts live — 公开构建中</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 3.5rem 1.5rem 2rem;
  }

  .footer-inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 2fr);
    gap: 3rem;
    padding-bottom: 2.5rem;
  }

  .footer-kicker {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }

  .footer-h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    line-height: 1.1;
    margin-bottom: 0.9rem;
    letter-spacing: -0.015em;
  }

  .footer-h2 em {
    font-style: italic;
    color: var(--color-accent);
  }

  .footer-copy {
    max-width: 30rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    align-content: start;
  }

  .footer-cols > div {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .footer-cols a {
    color: var(--text);
    font-size: 0.92rem;
    transition: color 0.15s ease;
  }

  .footer-cols a:hover {
    color: var(--color-accent);
  }

  .friend-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    padding-bottom: 1.5rem;
  }

  .friend-links__title {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .friend-links__title:hover {
    color: var(--color-accent);
  }

  .friend-links__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .friend-links__list li {
    display: inline;
  }

  .friend-links__list li + li::before {
    content: " · ";
    color: var(--text-muted);
  }

  .friend-links__list a {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .friend-links__list a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .footer-note {
    text-transform: uppercase;
  }

  @media (max-width: 780px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }

    .footer-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
