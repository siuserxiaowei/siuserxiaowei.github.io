---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, portfolioProjects, recognition, tutorials } from '../data/portfolio.js';

const featured = portfolioProjects.filter((project) => project.featured);
const highlights = [
  { value: '22 章', label: 'Taku 实操手册', href: 'https://siuserxiaowei.github.io/taku-guide/' },
  { value: '15 章', label: 'Grok Bot 中文教程', href: 'https://grokguide.si/' },
  { value: '铜奖', label: 'HerClaw · 智能办公助手赛道', href: recognition.href },
];
---

<BaseLayout title="siuser小伟 · AI 实操、教程与作品" description="siuser小伟的公开作品与实操记录：AI Agent 工作流、Grok Bot 和 Taku 中文教程、知识动画、开源 Skills，以及 HerClaw 团队参赛经历。">
  <Header />
  <main class="flex-1">
    <section id="home" class="container hero-section">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="section-kicker">SIUSER 小伟 · CREATOR & BUILDER</p>
          <h1 class="hero-title display-serif">把 AI 跑通，<br />再把过程<em>讲清楚。</em></h1>
          <p class="hero-lede">{profile.description}</p>
          <div class="hero-actions">
            <a href="#projects" class="btn-primary">看代表作品 <span aria-hidden="true">↓</span></a>
            <a href="/about" class="btn-ghost">关于我与合作 <span aria-hidden="true">→</span></a>
          </div>
          <p class="hero-note">中文实操教程 <span>／</span> Agent 工作流 <span>／</span> 内容与工具</p>
        </div>
        <aside class="evidence-rail" aria-label="作品速览">
          <div class="rail-heading"><span>SELECTED WORK</span><span>2026</span></div>
          {highlights.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class="rail-item">
              <strong class="display-serif">{item.value}</strong>
              <span>{item.label}</span><i aria-hidden="true">↗</i>
            </a>
          ))}
          <p class="rail-note">每一项，都有可以打开看的作品。</p>
        </aside>
      </div>
      <div class="social-strip" aria-label="公开账号">
        <span>FIND ME</span>
        {profile.accounts.map((account) => (
          <a href={account.href} target="_blank" rel="noopener noreferrer">{account.label} <span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </section>

    <section id="projects" class="container section-block">
      <div class="section-heading">
        <div><p class="section-kicker">SELECTED PROJECTS / 01</p><h2 class="display-serif section-title">先看做出来的东西。</h2></div>
        <a href="/projects" class="text-link">全部作品与贡献 <span aria-hidden="true">→</span></a>
      </div>
      <div class="project-grid">
        {featured.map((project, index) => (
          <article class="project-card">
            <div class="card-meta"><span>{String(index + 1).padStart(2, '0')} / {project.category}</span><span>{project.status}</span></div>
            <p class="project-en">{project.titleEn}</p>
            <h3 class="display-serif"><a href={project.href} target="_blank" rel="noopener noreferrer">{project.title}</a></h3>
            <p class="project-summary">{project.summary}</p>
            <p class="project-detail">{project.detail}</p>
            <div class="card-actions">
              <a href={project.href} target="_blank" rel="noopener noreferrer">{project.linkLabel} <span aria-hidden="true">↗</span></a>
              {project.source && <a href={project.source} target="_blank" rel="noopener noreferrer">配方库 <span aria-hidden="true">↗</span></a>}
              {project.article && <a href={project.article} target="_blank" rel="noopener noreferrer">实测长文 <span aria-hidden="true">↗</span></a>}
            </div>
          </article>
        ))}
      </div>
      <div class="project-extra"><span>也在做</span><a href="https://ai-term-radar.taku.site/" target="_blank" rel="noopener noreferrer">AI 新词雷达 ↗</a><a href="https://github.com/siuserxiaowei/generate-xiaowei-covers" target="_blank" rel="noopener noreferrer">小伟封面 Skill ↗</a><a href="/tools">站内工具箱 →</a></div>
    </section>

    <section id="recognition" class="container section-block">
      <div class="award-panel">
        <div class="award-mark"><p class="section-kicker">RECOGNITION / 02</p><strong class="display-serif">铜奖<span>BRONZE</span></strong></div>
        <div class="award-copy"><p class="section-kicker">{recognition.project}</p><h2 class="display-serif">{recognition.title}</h2><p>{recognition.event}<br />{recognition.result}</p><p class="award-attribution">{recognition.contribution}</p><a href={recognition.href} target="_blank" rel="noopener noreferrer" class="text-link">查看官方获奖名单 <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section id="tutorials" class="container section-block">
      <div class="section-heading"><div><p class="section-kicker">FIELD NOTES / 03</p><h2 class="display-serif section-title">从实操到教程。</h2></div><p class="heading-note">把步骤、结果和踩坑放在一起，<br />让下一次尝试有据可循。</p></div>
      <div class="tutorial-list">
        {tutorials.map((tutorial, index) => (
          <a href={tutorial.href} target="_blank" rel="noopener noreferrer" class="tutorial-row">
            <span class="row-index">{String(index + 1).padStart(2, '0')}</span><div><p class="tutorial-category">{tutorial.category}</p><h3 class="display-serif">{tutorial.title}</h3><p class="tutorial-description">{tutorial.description}</p></div><span class="row-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section id="work" class="container section-block">
      <div class="section-heading"><div><p class="section-kicker">HOW I WORK / 04</p><h2 class="display-serif section-title">从自己的问题开始。</h2></div></div>
      <div class="practice-grid">
        <article><span>01 / TRY</span><h3 class="display-serif">先亲手用一遍</h3><p>带着一个具体需求体验工具，看能完成什么，也记录哪些地方还行不通。</p></article>
        <article><span>02 / BUILD</span><h3 class="display-serif">交付一个结果</h3><p>把流程做成网页、Skill、视频或文档，检查输出，再决定哪些步骤值得复用。</p></article>
        <article><span>03 / SHARE</span><h3 class="display-serif">把过程讲清楚</h3><p>公开操作、参考来源与实际贡献，给后来的人一条可以跟着尝试的路径。</p></article>
      </div>
      <div class="english-note" lang="en"><p class="section-kicker">A QUICK INTRO</p><p>I'm Xiaowei, a Chinese-language AI creator and builder. I turn hands-on experiments into practical tutorials, reusable agent workflows, tools and videos. My public work includes the Grok Bot Chinese guide, a 22-chapter Taku handbook, research Skills and the HerClaw team project, which won bronze in the Smart Office Assistant track.</p></div>
    </section>

    <section id="blog" class="container section-block archive-section">
      <div><p class="section-kicker">THE WORKBENCH</p><h2 class="display-serif">继续往里看看。</h2></div>
      <nav aria-label="站内内容"><a href="/blog">文章与笔记 <span aria-hidden="true">→</span></a><a href="/knowledge/">知识库 <span aria-hidden="true">→</span></a><a href="/tools">浏览器工具箱 <span aria-hidden="true">→</span></a><a href="/competitions">比赛雷达 <span aria-hidden="true">→</span></a></nav>
    </section>

    <section id="contact" class="container section-block contact-section">
      <div class="contact-panel"><div><p class="section-kicker">LET'S MAKE SOMETHING USEFUL</p><h2 class="display-serif section-title">有个想一起<br /><em>跑通的场景？</em></h2><p>欢迎交流 AI 产品实测、中文教程、内容合作和工作流实践。AI 订阅与账号供货相关需求，也可以在沟通时说明。</p></div><div class="contact-actions"><a href={`mailto:${profile.email}`} class="btn-primary">邮件联系 <span aria-hidden="true">→</span></a><a href="https://x.com/_HIT_SZ_" target="_blank" rel="noopener noreferrer" class="btn-ghost">在 X 找我 <span aria-hidden="true">↗</span></a><p>微信公众号：siuser小伟<br />{profile.email}</p></div></div>
      <p class="updated-note">作品资料更新于 {profile.updated} · 项目状态与本人贡献见各作品说明</p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .container { max-width: var(--container-max); margin: 0 auto; padding-inline: 1.5rem; }
  .hero-section { padding-top: clamp(4rem, 8vw, 7rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(15rem, .65fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .hero-title { margin-top: 1.2rem; font-size: clamp(2.9rem, 6.4vw, 5.6rem); letter-spacing: -.035em; line-height: 1.08; text-wrap: balance; }
  .hero-title em, .section-title em { color: var(--color-accent); font-style: italic; }
  .hero-lede { max-width: 41rem; margin-top: 1.6rem; color: var(--text-secondary); line-height: 1.9; font-size: 1.06rem; }
  .hero-actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.8rem; }
  .btn-primary, .btn-ghost { display: inline-flex; align-items: center; justify-content: center; gap: 1rem; min-height: 2.9rem; padding: .7rem 1.1rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-weight: 600; font-size: .9rem; transition: background .15s, color .15s; }
  .btn-primary { color: var(--color-accent-ink); border-color: var(--color-accent); background: var(--color-accent); }
  .btn-primary:hover { color: var(--color-accent-ink); background: var(--color-accent-hover); border-color: var(--color-accent-hover); }
  .btn-ghost:hover { border-color: var(--color-accent); }
  .hero-note { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.4rem; color: var(--text-muted); font-size: .78rem; }
  .hero-note span { color: var(--color-accent); }
  .evidence-rail { padding-left: 1.35rem; border-left: 2px solid var(--color-accent); }
  .rail-heading { display: flex; justify-content: space-between; color: var(--text-muted); font-family: var(--font-mono); font-size: .63rem; letter-spacing: .12em; padding-bottom: 1rem; }
  .rail-item { display: grid; grid-template-columns: 1fr auto; gap: .3rem 1rem; padding: 1.1rem 0; border-top: 1px solid var(--border); }
  .rail-item strong { font-size: 2.4rem; font-weight: 500; }
  .rail-item > span { grid-column: 1; color: var(--text-secondary); font-size: .8rem; }
  .rail-item i { grid-column: 2; grid-row: 1 / 3; align-self: center; font-style: normal; color: var(--color-accent); }
  .rail-note { margin-top: .7rem; color: var(--text-muted); font-size: .74rem; }
  .social-strip { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; padding-block: 1.2rem; margin-top: 3.3rem; border-block: 1px solid var(--border); font-size: .83rem; }
  .social-strip > span { font-family: var(--font-mono); font-size: .63rem; letter-spacing: .12em; color: var(--text-muted); }
  .social-strip a > span { color: var(--color-accent); padding-left: .3rem; }
  .section-block { padding-top: clamp(3.5rem, 7vw, 6rem); }
  .section-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-bottom: 2rem; }
  .section-title { margin-top: .7rem; font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1.2; letter-spacing: -.02em; }
  .text-link { display: inline-flex; gap: .7rem; padding-block: .4rem; border-bottom: 1px solid var(--border-strong); font-size: .85rem; white-space: nowrap; }
  .text-link span { color: var(--color-accent); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  .project-card { display: flex; flex-direction: column; min-width: 0; padding: clamp(1.3rem, 3vw, 2.2rem); border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); transition: background .18s; }
  .project-card:hover { background: var(--surface); }
  .card-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; font-size: .68rem; color: var(--text-muted); }
  .card-meta span:first-child { color: var(--color-accent); }
  .project-en { margin-top: 2.2rem; margin-bottom: .6rem; color: var(--text-muted); font-family: var(--font-mono); font-size: .63rem; letter-spacing: .1em; text-transform: uppercase; }
  .project-card h3 { font-size: clamp(1.5rem, 2.3vw, 2rem); line-height: 1.3; }
  .project-summary { margin-top: 1rem; line-height: 1.85; color: var(--text-secondary); font-size: .95rem; }
  .project-detail { margin-top: 1rem; font-size: .75rem; color: var(--text-muted); }
  .card-actions { display: flex; flex-wrap: wrap; gap: .6rem 1.3rem; margin-top: auto; padding-top: 1.5rem; font-size: .82rem; }
  .card-actions a { padding-bottom: .3rem; border-bottom: 1px solid var(--border); }
  .card-actions span { color: var(--color-accent); }
  .project-extra { display: flex; flex-wrap: wrap; gap: .65rem 1.3rem; margin-top: 1.2rem; font-size: .8rem; }
  .project-extra > span { color: var(--text-muted); }
  .award-panel { display: grid; grid-template-columns: minmax(13rem, .65fr) minmax(0, 1.4fr); gap: 3rem; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--border-strong); border-left: 4px solid var(--color-accent); background: var(--surface); }
  .award-mark strong { display: block; color: var(--color-accent); font-size: clamp(3.2rem, 6vw, 5rem); font-weight: 500; margin-top: 1.6rem; line-height: 1; }
  .award-mark strong span { display: block; margin-top: .8rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .28em; }
  .award-copy h2 { margin-top: .7rem; font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1.4; }
  .award-copy > p:not(.section-kicker) { margin-top: .8rem; color: var(--text-secondary); font-size: .9rem; line-height: 1.8; }
  .award-copy .award-attribution { color: var(--text-muted); font-size: .76rem; }
  .award-copy .text-link { margin-top: 1rem; }
  .heading-note { color: var(--text-secondary); line-height: 1.8; font-size: .9rem; }
  .tutorial-list { border-top: 1px solid var(--border); }
  .tutorial-row { display: grid; grid-template-columns: 3rem 1fr auto; align-items: center; gap: 1.5rem; padding: 1.6rem 0; border-bottom: 1px solid var(--border); }
  .row-index { color: var(--color-accent); font-family: var(--font-mono); font-size: .72rem; }
  .tutorial-category { color: var(--text-muted); font-size: .7rem; margin-bottom: .4rem; }
  .tutorial-row h3 { font-size: clamp(1.2rem, 2vw, 1.6rem); line-height: 1.4; }
  .tutorial-description { color: var(--text-secondary); font-size: .86rem; margin-top: .45rem; }
  .row-arrow { color: var(--color-accent); font-size: 1.4rem; }
  .practice-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .practice-grid article { padding-top: 1rem; border-top: 1px solid var(--border); }
  .practice-grid article > span { color: var(--color-accent); font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; }
  .practice-grid h3 { margin-top: 1.2rem; font-size: 1.55rem; }
  .practice-grid article > p { margin-top: .8rem; color: var(--text-secondary); font-size: .91rem; line-height: 1.8; }
  .english-note { margin-top: 2.3rem; padding: 1.5rem; background: var(--surface); border: 1px solid var(--border); }
  .english-note > p:last-child { max-width: 57rem; margin-top: .7rem; color: var(--text-secondary); font-size: .93rem; line-height: 1.85; }
  .archive-section { display: flex; align-items: start; justify-content: space-between; gap: 2rem; }
  .archive-section h2 { margin-top: .7rem; font-size: 2rem; }
  .archive-section nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem 2.5rem; }
  .archive-section nav a { display: flex; justify-content: space-between; gap: 1.8rem; padding-block: .65rem; border-bottom: 1px solid var(--border); font-size: .88rem; }
  .archive-section nav span { color: var(--color-accent); }
  .contact-section { padding-bottom: 4rem; }
  .contact-panel { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(14rem, .65fr); align-items: center; gap: 3rem; background: var(--surface); border: 1px solid var(--border-strong); padding: clamp(1.5rem, 4vw, 3rem); }
  .contact-panel > div > p:last-child { max-width: 35rem; color: var(--text-secondary); line-height: 1.85; font-size: .93rem; margin-top: 1.2rem; }
  .contact-actions { display: grid; gap: .7rem; }
  .contact-actions p { overflow-wrap: anywhere; }
  .updated-note { margin-top: 1.2rem; color: var(--text-muted); font-size: .72rem; }
  @media (max-width: 920px) {
    .hero-grid { grid-template-columns: 1fr; }
    .evidence-rail { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding: 1rem 0 0; border-left: 0; border-top: 2px solid var(--color-accent); }
    .rail-heading { grid-column: 1 / -1; padding-bottom: 0; }
    .rail-item { padding: .6rem 0; border-top: 0; }
    .rail-item strong { font-size: 2rem; }
    .rail-note { grid-column: 1 / -1; margin: 0; }
    .social-strip { margin-top: 2rem; }
  }
  @media (max-width: 680px) {
    .container { padding-inline: 1.2rem; }
    .hero-section { padding-top: 3rem; }
    .hero-title { font-size: clamp(2.6rem, 9vw, 3.9rem); }
    .hero-lede { font-size: 1rem; }
    .project-grid, .practice-grid, .award-panel, .contact-panel { grid-template-columns: 1fr; }
    .project-en { margin-top: 1.5rem; }
    .section-heading { align-items: start; flex-direction: column; gap: 1rem; }
    .section-title { font-size: 2rem; }
    .award-panel { gap: 1.8rem; }
    .award-mark strong { margin-top: 1rem; font-size: 3.2rem; }
    .award-mark strong span { display: inline-block; vertical-align: middle; margin: 0 0 0 1rem; }
    .tutorial-row { grid-template-columns: 1.5rem 1fr auto; gap: .7rem; }
    .tutorial-description { font-size: .82rem; }
    .practice-grid { gap: 1.5rem; }
    .archive-section { flex-direction: column; }
    .archive-section nav { width: 100%; gap: .6rem 1.3rem; }
    .social-strip { gap: .8rem 1.2rem; }
    .social-strip > span { width: 100%; }
    .evidence-rail { gap: .8rem; }
    .rail-item > span { font-size: .7rem; }
    .rail-item i { display: none; }
    .hero-actions > a { flex: 1; white-space: nowrap; padding-inline: .8rem; }
  }
</style>
