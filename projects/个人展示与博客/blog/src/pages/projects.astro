---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { portfolioProjects, profile } from '../data/portfolio.js';
---

<BaseLayout title="作品与项目 · siuser小伟" description="siuser小伟的中文教程、Agent Skills、知识动画和团队项目。查看实际成果、本人贡献与公开入口。">
  <Header />
  <main class="flex-1">
    <section class="mx-auto px-6 pt-32 pb-16 md:pt-40 md:pb-24" style="max-width: var(--container-max);">
      <div class="projects-hero">
        <div class="animate-fade-in stagger-1 flex items-center gap-3 mb-4">
          <p class="section-kicker">Selected Work</p>
          <span class="ledger-count">{portfolioProjects.length} 件作品 · {profile.updated}</span>
        </div>
        <h1 class="animate-fade-in stagger-2 projects-headline display-serif">
          从亲手实操，<br />到可以打开的<em>作品</em>。
        </h1>
        <p class="animate-fade-in stagger-3 projects-lede">
          教程、工具、动画与团队实践。每一项都写明做了什么、我参与了什么，以及现在能在哪里看到成果。
        </p>
        <p class="projects-english" lang="en">Chinese AI tutorials, reusable agent workflows and visual explainers. Each entry links to the work and describes my contribution.</p>
      </div>
    </section>

    <section class="mx-auto px-6 pb-32" style="max-width: var(--container-max);" aria-label="作品台账">
      <div class="projects-ledger">
        {portfolioProjects.map((project, index) => (
          <article id={project.id} class="project-entry animate-fade-in">
            <div class="project-rule"></div>
            <div class="project-row">
              <div class="project-index">
                <span class="index-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="index-era">{project.year} · {project.category}</span>
              </div>
              <div class="project-main">
                <header class="project-header">
                  <div>
                    <h2 class="project-title display-serif">{project.title}</h2>
                    <p class="project-titleEn" lang="en">{project.titleEn}</p>
                  </div>
                  <span class="status-chip status-chip-accent-2"><span class="status-dot"></span>{project.status}</span>
                </header>
                <p class="project-desc">{project.summary}</p>
                <div class="project-contribution">
                  <span>我的参与</span>
                  <p>{project.contribution}</p>
                </div>
                <p class="project-detail">{project.detail}</p>
                <div class="project-tags" aria-label="项目标签">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <div class="project-links">
                  <a href={project.href} target="_blank" rel="noopener noreferrer"><span>{project.linkLabel}</span><em aria-hidden="true">↗</em></a>
                  {project.source && <a href={project.source} target="_blank" rel="noopener noreferrer"><span>代码与配方</span><em aria-hidden="true">↗</em></a>}
                  {project.article && <a href={project.article} target="_blank" rel="noopener noreferrer"><span>制作复盘</span><em aria-hidden="true">↗</em></a>}
                  {project.gallery && <a href={project.gallery} target="_blank" rel="noopener noreferrer"><span>成品图库</span><em aria-hidden="true">↗</em></a>}
                </div>
              </div>
            </div>
          </article>
        ))}
        <div class="project-rule project-rule-foot"></div>
        <p class="projects-more">继续浏览 <a href="/my-projects">运营中的站点</a>、<a href="/blog">文章与记录</a>，或查看 <a href="/about">个人介绍与合作入口</a>。</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .ledger-count {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .projects-english {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .project-entry {
    scroll-margin-top: 6rem;
  }

  .project-row {
    margin-top: 2rem;
  }

  .project-contribution {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.8rem;
    margin-top: 1.25rem;
    padding-left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--border));
    font-size: 0.93rem;
    line-height: 1.8;
  }

  .project-contribution > span {
    color: var(--color-accent);
  }

  .project-contribution p,
  .project-detail {
    color: var(--text-secondary);
  }

  .project-detail {
    margin-top: 1rem;
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .project-links {
    flex-wrap: wrap;
  }

  .project-links a:focus-visible,
  .projects-more a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }

  .projects-hero {
    max-width: 52rem;
  }

  .projects-headline {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 5.2vw, 4.2rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .projects-headline em {
    color: var(--color-accent);
  }

  .projects-lede {
    margin-top: 1.8rem;
    max-width: 38rem;
    color: var(--text-secondary);
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.85;
  }

  .projects-ledger {
    display: grid;
    gap: 0;
  }

  .project-entry {
    padding-top: 3.8rem;
    padding-bottom: 3.8rem;
  }

  .project-rule {
    height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 35%, transparent), color-mix(in srgb, var(--border) 80%, transparent) 45%, transparent);
  }

  .project-rule-foot {
    margin-top: -1px;
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(9rem, 10rem) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  .project-index {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .index-num {
    font-family: var(--font-serif);
    font-size: clamp(3.2rem, 5.4vw, 4.8rem);
    line-height: 0.9;
    color: var(--color-accent);
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .index-era {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .project-main {
    min-width: 0;
  }

  .project-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .project-title {
    font-size: clamp(1.55rem, 2.4vw, 2.15rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--text);
  }

  .project-titleEn {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .status-chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    background: color-mix(in srgb, var(--surface-2) 75%, transparent);
  }

  .status-chip .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
  }

  .status-chip-accent .status-dot {
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .status-chip-accent-2 .status-dot {
    background: var(--color-accent-2);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent-2) 22%, transparent);
  }

  .status-chip-muted .status-dot {
    background: color-mix(in srgb, var(--text-secondary) 60%, transparent);
  }

  .status-chip-accent { color: var(--color-accent); }
  .status-chip-accent-2 { color: var(--color-accent-2); }
  .status-chip-muted { color: var(--text-secondary); }

  .project-desc {
    max-width: 42rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.85;
    text-wrap: pretty;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.4rem;
  }

  .project-tags span {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .project-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.6rem;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .project-links a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateX(2px);
  }

  .project-links a em {
    font-style: normal;
    color: var(--color-accent);
  }

  .projects-more {
    margin-top: 1.5rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .projects-more a {
    color: var(--text);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  .projects-more a:hover {
    color: var(--color-accent);
  }

  .project-private {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    opacity: 0.55;
  }

  @media (max-width: 860px) {
    .project-contribution {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .project-row {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .project-header {
      flex-direction: column;
      gap: 0.85rem;
    }

    .project-entry {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    .index-num {
      font-size: 3.4rem;
    }
  }
</style>
